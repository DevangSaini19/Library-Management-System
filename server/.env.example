# Copy this file to `server/.env` (or run `npm run setup` from the repo root) and
# restart the server. `.env` is git-ignored, so your credentials are never committed.

# Port the Express API listens on. The Angular dev server proxies /api -> this port
# (see client/proxy.conf.json), so keep them in sync if you change it.
PORT=5400

# MongoDB connection string.
#   - local Docker/`mongod` (default):  mongodb://127.0.0.1:27017
#   - MongoDB Atlas:                     mongodb+srv://<user>:<password>@<cluster>.mongodb.net
#   - Docker Atlas Local (search labs):  mongodb://127.0.0.1:27017/?directConnection=true
DATABASE_URI=mongodb://127.0.0.1:27017

# Database the app reads and writes. `npm run db:seed` fills this one with sample data.
DATABASE_NAME=library

# Secret used to sign the demo JWTs. Any value works locally; use a long random
# string anywhere the app is reachable from other people.
SECRET=secret

# --- Optional: vector-search workshop labs (server/src/embeddings) ---------------
# Not needed to run the app. Pick one of: openai | googleVertex | serverlessEndpoint
# EMBEDDINGS_SOURCE=serverlessEndpoint
# EMBEDDING_KEY=
# PROJECT_ID=
# PROJECT_LOCATION=
